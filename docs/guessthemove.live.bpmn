<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_UseCases"
                   targetNamespace="http://guessthemove.live/bpmn">

  <bpmn2:collaboration id="Collaboration_1">
    <bpmn2:participant id="Participant_Session" name="Guess the Move &#8212; Session" processRef="Process_Session" />
  </bpmn2:collaboration>

  <bpmn2:process id="Process_Session" name="Session" isExecutable="false">

    <bpmn2:laneSet id="LaneSet_1">
      <bpmn2:lane id="Lane_Visitor" name="Visitor">
        <bpmn2:flowNodeRef>StartEvent_1</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_WantHost</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_JoinMethod</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_OpenRoomLink</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_ScanQrCode</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_JoinMerge</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Host" name="Host">
        <bpmn2:flowNodeRef>Task_CreateSession</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_StartRound</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Reveal</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_RevealSplit</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_RevealJoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_OptionalToggles</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Continue</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_OppSplit</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_OppJoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_LastRound</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Finish</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_FinishSplit</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_DownloadPgnHost</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Participant" name="Participant">
        <bpmn2:flowNodeRef>Task_Join</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Submit</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RevealParticipant</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_OpponentResponseParticipant</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_DownloadPgnParticipant</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Presenter" name="Presenter">
        <bpmn2:flowNodeRef>Task_ShowRoomCode</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RoundInProgress</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RevealPresenter</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_OpponentResponsePresenter</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_ShowFinalResults</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Final</bpmn2:flowNodeRef>
      </bpmn2:lane>
    </bpmn2:laneSet>

    <bpmn2:startEvent id="StartEvent_1" name="Navigate to app.guessthemove.live">
      <bpmn2:outgoing>SF1</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:exclusiveGateway id="Gateway_WantHost" name="Host this game?" isMarkerVisible="true">
      <bpmn2:incoming>SF1</bpmn2:incoming>
      <bpmn2:outgoing>SF31</bpmn2:outgoing>
      <bpmn2:outgoing>SF32</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:exclusiveGateway id="Gateway_JoinMethod" name="How are you joining?" isMarkerVisible="true">
      <bpmn2:incoming>SF32</bpmn2:incoming>
      <bpmn2:outgoing>SF33</bpmn2:outgoing>
      <bpmn2:outgoing>SF34</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:task id="Task_OpenRoomLink" name="&quot;Open room link&quot;">
      <bpmn2:incoming>SF33</bpmn2:incoming>
      <bpmn2:outgoing>SF35</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:task>

    <bpmn2:task id="Task_ScanQrCode" name="&quot;Scan QR code&quot;">
      <bpmn2:incoming>SF34</bpmn2:incoming>
      <bpmn2:outgoing>SF36</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:task>

    <bpmn2:exclusiveGateway id="Gateway_JoinMerge">
      <bpmn2:incoming>SF35</bpmn2:incoming>
      <bpmn2:incoming>SF36</bpmn2:incoming>
      <bpmn2:outgoing>SF37</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:task id="Task_CreateSession" name="Create Session">
      <bpmn2:incoming>SF31</bpmn2:incoming>
      <bpmn2:outgoing>SF2</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_ShowRoomCode" name="Lobby &#8212; Room Code (QR + link)">
      <bpmn2:incoming>SF2</bpmn2:incoming>
      <bpmn2:outgoing>SF3</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_Join" name="&quot;Join&quot;">
      <bpmn2:incoming>SF3</bpmn2:incoming>
      <bpmn2:incoming>SF37</bpmn2:incoming>
      <bpmn2:outgoing>SF4</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:task>

    <bpmn2:task id="Task_StartRound" name="&quot;Start Round&quot;">
      <bpmn2:incoming>SF4</bpmn2:incoming>
      <bpmn2:outgoing>SF5</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_RoundInProgress" name="Round in progress">
      <bpmn2:incoming>SF5</bpmn2:incoming>
      <bpmn2:incoming>SF22</bpmn2:incoming>
      <bpmn2:outgoing>SF6</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_Submit" name="&quot;Submit&quot;">
      <bpmn2:incoming>SF6</bpmn2:incoming>
      <bpmn2:outgoing>SF7</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:task>

    <bpmn2:task id="Task_Reveal" name="&quot;Reveal&quot;">
      <bpmn2:incoming>SF7</bpmn2:incoming>
      <bpmn2:incoming>SF23</bpmn2:incoming>
      <bpmn2:outgoing>SF8</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:parallelGateway id="Gateway_RevealSplit">
      <bpmn2:incoming>SF8</bpmn2:incoming>
      <bpmn2:outgoing>SF9</bpmn2:outgoing>
      <bpmn2:outgoing>SF10</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:task id="Task_RevealPresenter" name="Reveal: board + full breakdown + Leaderboard">
      <bpmn2:incoming>SF9</bpmn2:incoming>
      <bpmn2:outgoing>SF11</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_RevealParticipant" name="Round Score + Variant (auto)">
      <bpmn2:incoming>SF10</bpmn2:incoming>
      <bpmn2:outgoing>SF12</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:task>

    <bpmn2:parallelGateway id="Gateway_RevealJoin">
      <bpmn2:incoming>SF11</bpmn2:incoming>
      <bpmn2:incoming>SF12</bpmn2:incoming>
      <bpmn2:outgoing>SF13</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:task id="Task_OptionalToggles" name="(optional) &quot;Room Statistics&quot; / &quot;Show leaderboard&quot;">
      <bpmn2:incoming>SF13</bpmn2:incoming>
      <bpmn2:outgoing>SF14</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_Continue" name="&quot;Continue&quot;">
      <bpmn2:incoming>SF14</bpmn2:incoming>
      <bpmn2:outgoing>SF15</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:parallelGateway id="Gateway_OppSplit">
      <bpmn2:incoming>SF15</bpmn2:incoming>
      <bpmn2:outgoing>SF16</bpmn2:outgoing>
      <bpmn2:outgoing>SF17</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:task id="Task_OpponentResponsePresenter" name="Opponent's response">
      <bpmn2:incoming>SF16</bpmn2:incoming>
      <bpmn2:outgoing>SF18</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_OpponentResponseParticipant" name="Opponent's response (read-only)">
      <bpmn2:incoming>SF17</bpmn2:incoming>
      <bpmn2:outgoing>SF19</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:task>

    <bpmn2:parallelGateway id="Gateway_OppJoin">
      <bpmn2:incoming>SF18</bpmn2:incoming>
      <bpmn2:incoming>SF19</bpmn2:incoming>
      <bpmn2:outgoing>SF20</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:exclusiveGateway id="Gateway_LastRound" name="last Round?" isMarkerVisible="true">
      <bpmn2:incoming>SF20</bpmn2:incoming>
      <bpmn2:outgoing>SF21</bpmn2:outgoing>
      <bpmn2:outgoing>SF22</bpmn2:outgoing>
      <bpmn2:outgoing>SF23</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:task id="Task_Finish" name="&quot;Finish&quot;">
      <bpmn2:incoming>SF21</bpmn2:incoming>
      <bpmn2:outgoing>SF24</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:parallelGateway id="Gateway_FinishSplit">
      <bpmn2:incoming>SF24</bpmn2:incoming>
      <bpmn2:outgoing>SF25</bpmn2:outgoing>
      <bpmn2:outgoing>SF26</bpmn2:outgoing>
      <bpmn2:outgoing>SF27</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:task id="Task_ShowFinalResults" name="Final Results: Podium + Leaderboard">
      <bpmn2:incoming>SF25</bpmn2:incoming>
      <bpmn2:outgoing>SF28</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_DownloadPgnHost" name="(optional) &quot;Download PGN&quot;">
      <bpmn2:incoming>SF26</bpmn2:incoming>
      <bpmn2:outgoing>SF29</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_DownloadPgnParticipant" name="(optional) &quot;Download my PGN&quot;">
      <bpmn2:incoming>SF27</bpmn2:incoming>
      <bpmn2:outgoing>SF30</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:task>

    <bpmn2:endEvent id="EndEvent_Final">
      <bpmn2:incoming>SF28</bpmn2:incoming>
      <bpmn2:incoming>SF29</bpmn2:incoming>
      <bpmn2:incoming>SF30</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:textAnnotation id="TextAnnotation_Offline">
      <bpmn2:text>Featured Game is selected offline, outside the app &#8212; a Candidate Game from the pre-analyzed library that clears the minimum Accuracy Score.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_Offline" sourceRef="Task_CreateSession" targetRef="TextAnnotation_Offline" associationDirection="None" />

    <bpmn2:sequenceFlow id="SF1" sourceRef="StartEvent_1" targetRef="Gateway_WantHost" />
    <bpmn2:sequenceFlow id="SF31" name="yes" sourceRef="Gateway_WantHost" targetRef="Task_CreateSession" />
    <bpmn2:sequenceFlow id="SF32" name="no" sourceRef="Gateway_WantHost" targetRef="Gateway_JoinMethod" />
    <bpmn2:sequenceFlow id="SF33" name="&quot;Open room link&quot;" sourceRef="Gateway_JoinMethod" targetRef="Task_OpenRoomLink" />
    <bpmn2:sequenceFlow id="SF34" name="&quot;Scan QR code&quot;" sourceRef="Gateway_JoinMethod" targetRef="Task_ScanQrCode" />
    <bpmn2:sequenceFlow id="SF35" sourceRef="Task_OpenRoomLink" targetRef="Gateway_JoinMerge" />
    <bpmn2:sequenceFlow id="SF36" sourceRef="Task_ScanQrCode" targetRef="Gateway_JoinMerge" />
    <bpmn2:sequenceFlow id="SF37" sourceRef="Gateway_JoinMerge" targetRef="Task_Join" />
    <bpmn2:sequenceFlow id="SF2" sourceRef="Task_CreateSession" targetRef="Task_ShowRoomCode" />
    <bpmn2:sequenceFlow id="SF3" sourceRef="Task_ShowRoomCode" targetRef="Task_Join" />
    <bpmn2:sequenceFlow id="SF4" sourceRef="Task_Join" targetRef="Task_StartRound" />
    <bpmn2:sequenceFlow id="SF5" sourceRef="Task_StartRound" targetRef="Task_RoundInProgress" />
    <bpmn2:sequenceFlow id="SF6" sourceRef="Task_RoundInProgress" targetRef="Task_Submit" />
    <bpmn2:sequenceFlow id="SF7" sourceRef="Task_Submit" targetRef="Task_Reveal" />
    <bpmn2:sequenceFlow id="SF8" sourceRef="Task_Reveal" targetRef="Gateway_RevealSplit" />
    <bpmn2:sequenceFlow id="SF9" sourceRef="Gateway_RevealSplit" targetRef="Task_RevealPresenter" />
    <bpmn2:sequenceFlow id="SF10" sourceRef="Gateway_RevealSplit" targetRef="Task_RevealParticipant" />
    <bpmn2:sequenceFlow id="SF11" sourceRef="Task_RevealPresenter" targetRef="Gateway_RevealJoin" />
    <bpmn2:sequenceFlow id="SF12" sourceRef="Task_RevealParticipant" targetRef="Gateway_RevealJoin" />
    <bpmn2:sequenceFlow id="SF13" sourceRef="Gateway_RevealJoin" targetRef="Task_OptionalToggles" />
    <bpmn2:sequenceFlow id="SF14" sourceRef="Task_OptionalToggles" targetRef="Task_Continue" />
    <bpmn2:sequenceFlow id="SF15" sourceRef="Task_Continue" targetRef="Gateway_OppSplit" />
    <bpmn2:sequenceFlow id="SF16" sourceRef="Gateway_OppSplit" targetRef="Task_OpponentResponsePresenter" />
    <bpmn2:sequenceFlow id="SF17" sourceRef="Gateway_OppSplit" targetRef="Task_OpponentResponseParticipant" />
    <bpmn2:sequenceFlow id="SF18" sourceRef="Task_OpponentResponsePresenter" targetRef="Gateway_OppJoin" />
    <bpmn2:sequenceFlow id="SF19" sourceRef="Task_OpponentResponseParticipant" targetRef="Gateway_OppJoin" />
    <bpmn2:sequenceFlow id="SF20" sourceRef="Gateway_OppJoin" targetRef="Gateway_LastRound" />
    <bpmn2:sequenceFlow id="SF21" name="yes &#8212; &quot;Finish&quot;" sourceRef="Gateway_LastRound" targetRef="Task_Finish" />
    <bpmn2:sequenceFlow id="SF22" name="no &#8212; &quot;Next Round&quot;" sourceRef="Gateway_LastRound" targetRef="Task_RoundInProgress" />
    <bpmn2:sequenceFlow id="SF23" name="no &#8212; &quot;Back&quot; (undo)" sourceRef="Gateway_LastRound" targetRef="Task_Reveal" />
    <bpmn2:sequenceFlow id="SF24" sourceRef="Task_Finish" targetRef="Gateway_FinishSplit" />
    <bpmn2:sequenceFlow id="SF25" sourceRef="Gateway_FinishSplit" targetRef="Task_ShowFinalResults" />
    <bpmn2:sequenceFlow id="SF26" sourceRef="Gateway_FinishSplit" targetRef="Task_DownloadPgnHost" />
    <bpmn2:sequenceFlow id="SF27" sourceRef="Gateway_FinishSplit" targetRef="Task_DownloadPgnParticipant" />
    <bpmn2:sequenceFlow id="SF28" sourceRef="Task_ShowFinalResults" targetRef="EndEvent_Final" />
    <bpmn2:sequenceFlow id="SF29" sourceRef="Task_DownloadPgnHost" targetRef="EndEvent_Final" />
    <bpmn2:sequenceFlow id="SF30" sourceRef="Task_DownloadPgnParticipant" targetRef="EndEvent_Final" />

  </bpmn2:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_Session_di" bpmnElement="Participant_Session" isHorizontal="true">
        <dc:Bounds x="0" y="70" width="3990" height="620" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Visitor_di" bpmnElement="Lane_Visitor" isHorizontal="true">
        <dc:Bounds x="30" y="70" width="3960" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Host_di" bpmnElement="Lane_Host" isHorizontal="true">
        <dc:Bounds x="30" y="210" width="3960" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Participant_di" bpmnElement="Lane_Participant" isHorizontal="true">
        <dc:Bounds x="30" y="370" width="3960" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Presenter_di" bpmnElement="Lane_Presenter" isHorizontal="true">
        <dc:Bounds x="30" y="530" width="3960" height="160" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TextAnnotation_Offline_di" bpmnElement="TextAnnotation_Offline">
        <dc:Bounds x="816" y="5" width="240" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_Offline_di" bpmnElement="Association_Offline">
        <di:waypoint x="906" y="60" />
        <di:waypoint x="891" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="80" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_WantHost_di" bpmnElement="Gateway_WantHost">
        <dc:Bounds x="180" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinMethod_di" bpmnElement="Gateway_JoinMethod">
        <dc:Bounds x="280" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenRoomLink_di" bpmnElement="Task_OpenRoomLink">
        <dc:Bounds x="380" y="75" width="150" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanQrCode_di" bpmnElement="Task_ScanQrCode">
        <dc:Bounds x="380" y="135" width="150" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinMerge_di" bpmnElement="Gateway_JoinMerge">
        <dc:Bounds x="560" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateSession_di" bpmnElement="Task_CreateSession">
        <dc:Bounds x="816" y="250" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowRoomCode_di" bpmnElement="Task_ShowRoomCode">
        <dc:Bounds x="1016" y="570" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Join_di" bpmnElement="Task_Join">
        <dc:Bounds x="1016" y="410" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StartRound_di" bpmnElement="Task_StartRound">
        <dc:Bounds x="1226" y="250" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RoundInProgress_di" bpmnElement="Task_RoundInProgress">
        <dc:Bounds x="1416" y="570" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Submit_di" bpmnElement="Task_Submit">
        <dc:Bounds x="1626" y="410" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reveal_di" bpmnElement="Task_Reveal">
        <dc:Bounds x="1816" y="250" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RevealSplit_di" bpmnElement="Gateway_RevealSplit">
        <dc:Bounds x="1986" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RevealPresenter_di" bpmnElement="Task_RevealPresenter">
        <dc:Bounds x="2086" y="570" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RevealParticipant_di" bpmnElement="Task_RevealParticipant">
        <dc:Bounds x="2086" y="410" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RevealJoin_di" bpmnElement="Gateway_RevealJoin">
        <dc:Bounds x="2306" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OptionalToggles_di" bpmnElement="Task_OptionalToggles">
        <dc:Bounds x="2406" y="250" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Continue_di" bpmnElement="Task_Continue">
        <dc:Bounds x="2646" y="250" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OppSplit_di" bpmnElement="Gateway_OppSplit">
        <dc:Bounds x="2816" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpponentResponsePresenter_di" bpmnElement="Task_OpponentResponsePresenter">
        <dc:Bounds x="2916" y="570" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpponentResponseParticipant_di" bpmnElement="Task_OpponentResponseParticipant">
        <dc:Bounds x="2916" y="410" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OppJoin_di" bpmnElement="Gateway_OppJoin">
        <dc:Bounds x="3136" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LastRound_di" bpmnElement="Gateway_LastRound">
        <dc:Bounds x="3236" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Finish_di" bpmnElement="Task_Finish">
        <dc:Bounds x="3336" y="250" width="110" height="80" />

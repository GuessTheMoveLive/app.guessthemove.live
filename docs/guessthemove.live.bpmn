<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_UseCases"
                   targetNamespace="http://guessthemove.live/bpmn">

  <bpmn2:collaboration id="Collaboration_1">
    <bpmn2:participant id="Participant_Session" name="Session" processRef="Process_Session" />
  </bpmn2:collaboration>

  <bpmn2:process id="Process_Session" name="Session" isExecutable="false">

    <bpmn2:laneSet id="LaneSet_1">
      <bpmn2:lane id="Lane_Visitor" name="Visitor">
        <bpmn2:flowNodeRef>StartEvent_1</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_HostOrJoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_JoinMethod</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Host" name="Host">
        <bpmn2:flowNodeRef>Task_ClickHostLink</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_CreateSession</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_StartRound</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_RoundSplit</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_HostLiveMonitor</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_RoundJoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Reveal</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_RevealSplit</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_RevealJoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>SubProcess_OptionalReview</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Continue</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_OppSplit</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_OppJoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_LastRound</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Finish</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_FinishSplit</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_DownloadPgnHost</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Participant" name="Participant">
        <bpmn2:flowNodeRef>Task_Join</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Decide</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Submit</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RevealParticipant</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_OpponentResponseParticipant</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_PlayOpponentMove</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_DownloadPgnParticipant</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Presenter" name="Presenter">
        <bpmn2:flowNodeRef>Task_ShowRoomCode</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RoundInProgress</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RevealPresenter</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_OpponentResponsePresenter</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_ShowFinalResults</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Final</bpmn2:flowNodeRef>
      </bpmn2:lane>
    </bpmn2:laneSet>

    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>SF1</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:exclusiveGateway id="Gateway_HostOrJoin" name="Host or join?" isMarkerVisible="true">
      <bpmn2:incoming>SF1</bpmn2:incoming>
      <bpmn2:outgoing>SF2</bpmn2:outgoing>
      <bpmn2:outgoing>SF3</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:exclusiveGateway id="Gateway_JoinMethod" name="How are you joining?" isMarkerVisible="true">
      <bpmn2:incoming>SF3</bpmn2:incoming>
      <bpmn2:outgoing>SF4</bpmn2:outgoing>
      <bpmn2:outgoing>SF5</bpmn2:outgoing>
      <bpmn2:outgoing>SF6</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:userTask id="Task_ClickHostLink" name="Click on &quot;Hosting this session?&quot;">
      <bpmn2:incoming>SF2</bpmn2:incoming>
      <bpmn2:outgoing>SF7</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:serviceTask id="Task_CreateSession" name="Create session">
      <bpmn2:incoming>SF7</bpmn2:incoming>
      <bpmn2:outgoing>SF8</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:serviceTask id="Task_ShowRoomCode" name="Display room code">
      <bpmn2:incoming>SF8</bpmn2:incoming>
      <bpmn2:outgoing>SF9</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:userTask id="Task_Join" name="Click on &quot;Join&quot;">
      <bpmn2:incoming>SF4</bpmn2:incoming>
      <bpmn2:incoming>SF5</bpmn2:incoming>
      <bpmn2:incoming>SF6</bpmn2:incoming>
      <bpmn2:incoming>SF9</bpmn2:incoming>
      <bpmn2:outgoing>SF10</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:userTask>

    <bpmn2:userTask id="Task_StartRound" name="Click on &quot;Start Round&quot;">
      <bpmn2:incoming>SF10</bpmn2:incoming>
      <bpmn2:outgoing>SF11</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:parallelGateway id="Gateway_RoundSplit">
      <bpmn2:incoming>SF11</bpmn2:incoming>
      <bpmn2:incoming>SF35</bpmn2:incoming>
      <bpmn2:outgoing>SF12</bpmn2:outgoing>
      <bpmn2:outgoing>SF13</bpmn2:outgoing>
      <bpmn2:outgoing>SF14</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:serviceTask id="Task_RoundInProgress" name="Display round timer and submission count">
      <bpmn2:incoming>SF12</bpmn2:incoming>
      <bpmn2:outgoing>SF16</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:serviceTask id="Task_HostLiveMonitor" name="Display live submission count and timer">
      <bpmn2:incoming>SF13</bpmn2:incoming>
      <bpmn2:outgoing>SF17</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:manualTask id="Task_Decide" name="Decide on a guess">
      <bpmn2:incoming>SF14</bpmn2:incoming>
      <bpmn2:outgoing>SF15</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:manualTask>

    <bpmn2:userTask id="Task_Submit" name="Click on &quot;Submit&quot;">
      <bpmn2:incoming>SF15</bpmn2:incoming>
      <bpmn2:outgoing>SF18</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:userTask>

    <bpmn2:parallelGateway id="Gateway_RoundJoin">
      <bpmn2:incoming>SF16</bpmn2:incoming>
      <bpmn2:incoming>SF17</bpmn2:incoming>
      <bpmn2:incoming>SF18</bpmn2:incoming>
      <bpmn2:outgoing>SF19</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:userTask id="Task_Reveal" name="Click on &quot;Reveal&quot;">
      <bpmn2:incoming>SF19</bpmn2:incoming>
      <bpmn2:incoming>SF36</bpmn2:incoming>
      <bpmn2:outgoing>SF20</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:parallelGateway id="Gateway_RevealSplit">
      <bpmn2:incoming>SF20</bpmn2:incoming>
      <bpmn2:outgoing>SF21</bpmn2:outgoing>
      <bpmn2:outgoing>SF22</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:serviceTask id="Task_RevealPresenter" name="Display round results">
      <bpmn2:incoming>SF21</bpmn2:incoming>
      <bpmn2:outgoing>SF23</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:serviceTask id="Task_RevealParticipant" name="Display round score">
      <bpmn2:incoming>SF22</bpmn2:incoming>
      <bpmn2:outgoing>SF24</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:serviceTask>

    <bpmn2:parallelGateway id="Gateway_RevealJoin">
      <bpmn2:incoming>SF23</bpmn2:incoming>
      <bpmn2:incoming>SF24</bpmn2:incoming>
      <bpmn2:outgoing>SF25</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:adHocSubProcess id="SubProcess_OptionalReview" name="Review results (optional)">
      <bpmn2:incoming>SF25</bpmn2:incoming>
      <bpmn2:outgoing>SF26</bpmn2:outgoing>
      <bpmn2:userTask id="Task_ToggleRoomStatistics" name="Click on &quot;Room Statistics&quot;" />
      <bpmn2:userTask id="Task_ToggleShowRanking" name="Click on &quot;Show ranking&quot;" />
    </bpmn2:adHocSubProcess>

    <bpmn2:userTask id="Task_Continue" name="Click on &quot;Continue&quot;">
      <bpmn2:incoming>SF26</bpmn2:incoming>
      <bpmn2:outgoing>SF27</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:parallelGateway id="Gateway_OppSplit">
      <bpmn2:incoming>SF27</bpmn2:incoming>
      <bpmn2:outgoing>SF28</bpmn2:outgoing>
      <bpmn2:outgoing>SF29</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:serviceTask id="Task_OpponentResponsePresenter" name="Display opponent's move">
      <bpmn2:incoming>SF28</bpmn2:incoming>
      <bpmn2:outgoing>SF31</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:serviceTask id="Task_OpponentResponseParticipant" name="Display opponent's response">
      <bpmn2:incoming>SF29</bpmn2:incoming>
      <bpmn2:outgoing>SF30</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:serviceTask>

    <bpmn2:manualTask id="Task_PlayOpponentMove" name="Play opponent's move on the board">
      <bpmn2:incoming>SF30</bpmn2:incoming>
      <bpmn2:outgoing>SF32</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:manualTask>

    <bpmn2:parallelGateway id="Gateway_OppJoin">
      <bpmn2:incoming>SF31</bpmn2:incoming>
      <bpmn2:incoming>SF32</bpmn2:incoming>
      <bpmn2:outgoing>SF33</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:exclusiveGateway id="Gateway_LastRound" name="What next?" isMarkerVisible="true">
      <bpmn2:incoming>SF33</bpmn2:incoming>
      <bpmn2:outgoing>SF34</bpmn2:outgoing>
      <bpmn2:outgoing>SF35</bpmn2:outgoing>
      <bpmn2:outgoing>SF36</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:userTask id="Task_Finish" name="Click on &quot;Finish&quot;">
      <bpmn2:incoming>SF34</bpmn2:incoming>
      <bpmn2:outgoing>SF37</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:parallelGateway id="Gateway_FinishSplit">
      <bpmn2:incoming>SF37</bpmn2:incoming>
      <bpmn2:outgoing>SF38</bpmn2:outgoing>
      <bpmn2:outgoing>SF39</bpmn2:outgoing>
      <bpmn2:outgoing>SF40</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:serviceTask id="Task_ShowFinalResults" name="Display final results">
      <bpmn2:incoming>SF38</bpmn2:incoming>
      <bpmn2:outgoing>SF41</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:userTask id="Task_DownloadPgnHost" name="Click on &quot;Download PGN&quot;">
      <bpmn2:incoming>SF39</bpmn2:incoming>
      <bpmn2:outgoing>SF42</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:userTask id="Task_DownloadPgnParticipant" name="Click on &quot;Download my PGN&quot;">
      <bpmn2:incoming>SF40</bpmn2:incoming>
      <bpmn2:outgoing>SF43</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:userTask>

    <bpmn2:endEvent id="EndEvent_Final" name="Session complete">
      <bpmn2:incoming>SF41</bpmn2:incoming>
      <bpmn2:incoming>SF42</bpmn2:incoming>
      <bpmn2:incoming>SF43</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:textAnnotation id="TextAnnotation_Offline">
      <bpmn2:text>Featured Game is selected offline, outside the app &#8212; a Candidate Game from the pre-analyzed library that clears the minimum Accuracy Score.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_Offline" sourceRef="Task_CreateSession" targetRef="TextAnnotation_Offline" associationDirection="None" />

    <bpmn2:textAnnotation id="TextAnnotation_OptionalDownloads">
      <bpmn2:text>Optional &#8212; PGN download is not required to reach the end of the session.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_OptionalDownloads1" sourceRef="Task_DownloadPgnHost" targetRef="TextAnnotation_OptionalDownloads" associationDirection="None" />
    <bpmn2:association id="Association_OptionalDownloads2" sourceRef="Task_DownloadPgnParticipant" targetRef="TextAnnotation_OptionalDownloads" associationDirection="None" />

    <bpmn2:sequenceFlow id="SF1" sourceRef="StartEvent_1" targetRef="Gateway_HostOrJoin" />
    <bpmn2:sequenceFlow id="SF2" name="Host" sourceRef="Gateway_HostOrJoin" targetRef="Task_ClickHostLink" />
    <bpmn2:sequenceFlow id="SF3" name="Join" sourceRef="Gateway_HostOrJoin" targetRef="Gateway_JoinMethod" />
    <bpmn2:sequenceFlow id="SF4" name="Open room link" sourceRef="Gateway_JoinMethod" targetRef="Task_Join" />
    <bpmn2:sequenceFlow id="SF5" name="Scan QR code" sourceRef="Gateway_JoinMethod" targetRef="Task_Join" />
    <bpmn2:sequenceFlow id="SF6" name="Enter room code" sourceRef="Gateway_JoinMethod" targetRef="Task_Join" />
    <bpmn2:sequenceFlow id="SF7" sourceRef="Task_ClickHostLink" targetRef="Task_CreateSession" />
    <bpmn2:sequenceFlow id="SF8" sourceRef="Task_CreateSession" targetRef="Task_ShowRoomCode" />
    <bpmn2:sequenceFlow id="SF9" sourceRef="Task_ShowRoomCode" targetRef="Task_Join" />
    <bpmn2:sequenceFlow id="SF10" sourceRef="Task_Join" targetRef="Task_StartRound" />
    <bpmn2:sequenceFlow id="SF11" sourceRef="Task_StartRound" targetRef="Gateway_RoundSplit" />
    <bpmn2:sequenceFlow id="SF12" sourceRef="Gateway_RoundSplit" targetRef="Task_RoundInProgress" />
    <bpmn2:sequenceFlow id="SF13" sourceRef="Gateway_RoundSplit" targetRef="Task_HostLiveMonitor" />
    <bpmn2:sequenceFlow id="SF14" sourceRef="Gateway_RoundSplit" targetRef="Task_Decide" />
    <bpmn2:sequenceFlow id="SF15" sourceRef="Task_Decide" targetRef="Task_Submit" />
    <bpmn2:sequenceFlow id="SF16" sourceRef="Task_RoundInProgress" targetRef="Gateway_RoundJoin" />
    <bpmn2:sequenceFlow id="SF17" sourceRef="Task_HostLiveMonitor" targetRef="Gateway_RoundJoin" />
    <bpmn2:sequenceFlow id="SF18" sourceRef="Task_Submit" targetRef="Gateway_RoundJoin" />
    <bpmn2:sequenceFlow id="SF19" sourceRef="Gateway_RoundJoin" targetRef="Task_Reveal" />
    <bpmn2:sequenceFlow id="SF20" sourceRef="Task_Reveal" targetRef="Gateway_RevealSplit" />
    <bpmn2:sequenceFlow id="SF21" sourceRef="Gateway_RevealSplit" targetRef="Task_RevealPresenter" />
    <bpmn2:sequenceFlow id="SF22" sourceRef="Gateway_RevealSplit" targetRef="Task_RevealParticipant" />
    <bpmn2:sequenceFlow id="SF23" sourceRef="Task_RevealPresenter" targetRef="Gateway_RevealJoin" />
    <bpmn2:sequenceFlow id="SF24" sourceRef="Task_RevealParticipant" targetRef="Gateway_RevealJoin" />
    <bpmn2:sequenceFlow id="SF25" sourceRef="Gateway_RevealJoin" targetRef="SubProcess_OptionalReview" />
    <bpmn2:sequenceFlow id="SF26" sourceRef="SubProcess_OptionalReview" targetRef="Task_Continue" />
    <bpmn2:sequenceFlow id="SF27" sourceRef="Task_Continue" targetRef="Gateway_OppSplit" />
    <bpmn2:sequenceFlow id="SF28" sourceRef="Gateway_OppSplit" targetRef="Task_OpponentResponsePresenter" />
    <bpmn2:sequenceFlow id="SF29" sourceRef="Gateway_OppSplit" targetRef="Task_OpponentResponseParticipant" />
    <bpmn2:sequenceFlow id="SF30" sourceRef="Task_OpponentResponseParticipant" targetRef="Task_PlayOpponentMove" />
    <bpmn2:sequenceFlow id="SF31" sourceRef="Task_OpponentResponsePresenter" targetRef="Gateway_OppJoin" />
    <bpmn2:sequenceFlow id="SF32" sourceRef="Task_PlayOpponentMove" targetRef="Gateway_OppJoin" />
    <bpmn2:sequenceFlow id="SF33" sourceRef="Gateway_OppJoin" targetRef="Gateway_LastRound" />
    <bpmn2:sequenceFlow id="SF34" name="Finish" sourceRef="Gateway_LastRound" targetRef="Task_Finish" />
    <bpmn2:sequenceFlow id="SF35" name="Next round" sourceRef="Gateway_LastRound" targetRef="Gateway_RoundSplit" />
    <bpmn2:sequenceFlow id="SF36" name="Undo" sourceRef="Gateway_LastRound" targetRef="Task_Reveal" />
    <bpmn2:sequenceFlow id="SF37" sourceRef="Task_Finish" targetRef="Gateway_FinishSplit" />
    <bpmn2:sequenceFlow id="SF38" sourceRef="Gateway_FinishSplit" targetRef="Task_ShowFinalResults" />
    <bpmn2:sequenceFlow id="SF39" sourceRef="Gateway_FinishSplit" targetRef="Task_DownloadPgnHost" />
    <bpmn2:sequenceFlow id="SF40" sourceRef="Gateway_FinishSplit" targetRef="Task_DownloadPgnParticipant" />
    <bpmn2:sequenceFlow id="SF41" sourceRef="Task_ShowFinalResults" targetRef="EndEvent_Final" />
    <bpmn2:sequenceFlow id="SF42" sourceRef="Task_DownloadPgnHost" targetRef="EndEvent_Final" />
    <bpmn2:sequenceFlow id="SF43" sourceRef="Task_DownloadPgnParticipant" targetRef="EndEvent_Final" />

  </bpmn2:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_Session_di" bpmnElement="Participant_Session" isHorizontal="true">
        <dc:Bounds x="0" y="70" width="4460" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Visitor_di" bpmnElement="Lane_Visitor" isHorizontal="true">
        <dc:Bounds x="30" y="70" width="4430" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Host_di" bpmnElement="Lane_Host" isHorizontal="true">
        <dc:Bounds x="30" y="230" width="4430" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Participant_di" bpmnElement="Lane_Participant" isHorizontal="true">
        <dc:Bounds x="30" y="390" width="4430" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Presenter_di" bpmnElement="Lane_Presenter" isHorizontal="true">
        <dc:Bounds x="30" y="550" width="4430" height="160" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TextAnnotation_Offline_di" bpmnElement="TextAnnotation_Offline">
        <dc:Bounds x="490" y="5" width="240" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_Offline_di" bpmnElement="Association_Offline">
        <di:waypoint x="580" y="60" />
        <di:waypoint x="565" y="270" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="TextAnnotation_OptionalDownloads_di" bpmnElement="TextAnnotation_OptionalDownloads">
        <dc:Bounds x="4130" y="150" width="240" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_OptionalDownloads1_di" bpmnElement="Association_OptionalDownloads1">
        <di:waypoint x="4205" y="270" />
        <di:waypoint x="4220" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_OptionalDownloads2_di" bpmnElement="Association_OptionalDownloads2">
        <di:waypoint x="4215" y="430" />
        <di:waypoint x="4270" y="205" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="80" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HostOrJoin_di" bpmnElement="Gateway_HostOrJoin">
        <dc:Bounds x="170" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinMethod_di" bpmnElement="Gateway_JoinMethod">
        <dc:Bounds x="270" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClickHostLink_di" bpmnElement="Task_ClickHostLink">
        <dc:Bounds x="270" y="270" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateSession_di" bpmnElement="Task_CreateSession">
        <dc:Bounds x="490" y="270" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowRoomCode_di" bpmnElement="Task_ShowRoomCode">
        <dc:Bounds x="690" y="590" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Join_di" bpmnElement="Task_Join">
        <dc:Bounds x="910" y="430" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StartRound_di" bpmnElement="Task_StartRound">
        <dc:Bounds x="1100" y="270" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RoundSplit_di" bpmnElement="Gateway_RoundSplit">
        <dc:Bounds x="1290" y="285" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RoundInProgress_di" bpmnElement="Task_RoundInProgress">

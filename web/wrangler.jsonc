{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "web",
	"compatibility_date": "2026-10-27",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": "src/worker-entry.ts",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION_ROOM",
				"class_name": "SessionRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SessionRoom"]
		}
	],
	"workers_dev": true,
	"preview_urls": true
}

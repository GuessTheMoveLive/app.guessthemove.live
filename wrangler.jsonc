{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "web",
	"compatibility_date": "2026-10-27",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": "src/worker-entry.ts",
	"routes": [{ "pattern": "preview.app.guessthemove.live", "custom_domain": true }],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION_ROOM",
				"class_name": "SessionRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SessionRoom"]
		}
	],
	"workers_dev": true,
	"preview_urls": true,
	// Cloudflare's Git-integrated Workers Builds CI hardcodes its deploy command to
	// `wrangler deploy --env preview` for this project (dashboard-configured, not
	// something we control from the repo) - without a matching named environment,
	// wrangler warns and falls back to the top-level config regardless, but we mirror
	// it explicitly so `--env preview` deploys to the exact same Worker ("web"), same
	// route, same bindings, rather than silently drifting.
	"env": {
		"preview": {
			"name": "web",
			"routes": [{ "pattern": "preview.app.guessthemove.live", "custom_domain": true }],
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare"
			},
			"durable_objects": {
				"bindings": [
					{
						"name": "SESSION_ROOM",
						"class_name": "SessionRoom"
					}
				]
			}
		}
	}
}
